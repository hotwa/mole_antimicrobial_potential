# Required paths
REINVENT4_ROOT=/absolute/path/to/REINVENT4
REINVENT4_RUNNER=reinvent
REINVENT4_PRIOR_FILE=/absolute/path/to/libinvent.prior
# Optional: if omitted, the prior file is reused as the starting agent
# REINVENT4_AGENT_FILE=/absolute/path/to/libinvent.prior

# Local antimicrobial scoring service
MOLE_SCORE_API_URL=http://127.0.0.1:8000/score
# Optional: inferred automatically from MOLE_SCORE_API_URL if omitted
# MOLE_API_HEALTH_URL=http://127.0.0.1:8000/health

# Optional REINVENT4 defaults
REINVENT_DEVICE=cuda:0
REINVENT_BATCH_SIZE=64
REINVENT_SIGMA=128
REINVENT_LEARNING_RATE=0.0001
REINVENT_MAX_SCORE=0.8
REINVENT_MIN_STEPS=25
REINVENT_MAX_STEPS=500
REINVENT_BUCKET_SIZE=25
REINVENT_DIVERSITY_MINSCORE=0.4
MOLE_REQUEST_TIMEOUT_SECONDS=120
