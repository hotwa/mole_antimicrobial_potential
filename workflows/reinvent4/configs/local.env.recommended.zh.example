# 当前机器推荐使用的本地环境配置。
# 用法：
# 1. 复制为你自己的 local.env 文件
# 2. 按你的实际路径和硬件修改
# 3. run_reinvent4.py 通过 --env-file 读取这个文件

# 外部 REINVENT4 仓库根目录。
# 这里应当是你 clone 下来的 REINVENT4 本地目录，而不是当前仓库目录。
REINVENT4_ROOT=/home/lingyuzeng/project/REINVENT4-main

# 实际调用 REINVENT4 的命令名。
# 如果你已经通过 install.py 安装成功，通常就是 reinvent。
# 如果你的环境里命令名不同，可以改成完整可执行路径。
REINVENT4_RUNNER=reinvent

# LibInvent prior 权重文件。
# 第一轮实验最关键的就是这个文件，通常先用 libinvent.prior。
REINVENT4_PRIOR_FILE=/home/lingyuzeng/project/reinvent4_assets/priors/libinvent.prior

# 可选：agent 初始权重文件。
# 第一轮实验通常可以直接让 agent 和 prior 使用同一个文件。
# 如果你后续已经跑出 checkpoint，也可以把这里改成某个 stage*.chkpt。
# REINVENT4_AGENT_FILE=/home/lingyuzeng/project/reinvent4_assets/priors/libinvent.prior

# 当前仓库 FastAPI 暴露的 /score 接口地址。
# REINVENT4 的 reward 直接来自这里。
MOLE_SCORE_API_URL=http://127.0.0.1:8000/score

# 可选：健康检查地址。
# 不填时脚本会根据 /score 自动推断；显式写出来便于排查服务是否启动。
# MOLE_API_HEALTH_URL=http://127.0.0.1:8000/health

# REINVENT4 运行设备。
# 有 GPU 时可写 cuda:0、cuda:1；没有 GPU 时改成 cpu。
REINVENT_DEVICE=cuda:0

# 每一步 REINVENT4 生成并打分的分子批量大小。
# 值越大吞吐越高，但对显存、内存和 /score 服务压力也越大。
REINVENT_BATCH_SIZE=64

# DAP 学习策略里的 sigma。
# 值越大，reward 对 agent 更新的影响越强。
# 初期可先保持默认，等 reward 信号稳定后再调。
REINVENT_SIGMA=128

# RL 学习率。
# 太大容易训练不稳，太小则收敛很慢。
REINVENT_LEARNING_RATE=0.0001

# 提前终止分数阈值。
# 当 REINVENT4 认为达到这个分数时，stage 可以提前结束。
# 对当前抗菌任务，0.8 是一个偏保守的默认值。
REINVENT_MAX_SCORE=0.8

# 每个 stage 至少运行多少步。
# 防止模型在早期因为偶然高分样本过早停止。
REINVENT_MIN_STEPS=25

# 每个 stage 最多运行多少步。
# 正式实验可以按算力和目标提高；smoke test 通常远小于这个值。
REINVENT_MAX_STEPS=500

# Diversity filter 的 bucket 大小。
# 值越大，同一 Murcko scaffold 家族里允许保留的分子越多。
REINVENT_BUCKET_SIZE=25

# Diversity filter 的最小生效分数。
# 只有分数高于这个值的分子才会进入 scaffold bucket 参与多样性控制。
REINVENT_DIVERSITY_MINSCORE=0.4

# /score 或 /predict 单次请求超时时间，单位秒。
# MolE 第一次加载较慢，时间过短会导致 REINVENT4 误判打分服务失败。
MOLE_REQUEST_TIMEOUT_SECONDS=120
